# Process environment reference only. Never put a real private key in this file.
# PRIVATE_KEY        owner key, supplied securely in the process environment
# AGENT_PRIVATE_KEY  agent (hot) key for script/Spend.s.sol, supplied the same way
# OWNER=0x...        address of PRIVATE_KEY (cold key: unfreeze, setCap, withdraw)
# AGENT=0x...        address of AGENT_PRIVATE_KEY (may equal OWNER for a quick demo)
# Existing-deployment addresses (TOKEN, REACTIVE, WALLET) must stay unset until known.
TOKEN_SUPPLY_WEI=1000000000000000000000000
FUND_WEI=1000000000000000000000
CAP_WEI=100000000000000000000
REACTIVE_FUND_WEI=1000000000000000000
CALLBACK_FUND_WEI=10000000000000000
# Optional overrides (defaults shown): THRESHOLD defaults to SpendguardModel.THRESHOLD
# CALLBACK_GAS=200000
# RETRY_SECONDS=60
